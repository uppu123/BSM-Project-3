   "source": [
    "# 01_eda_and_dataset.ipynb - EDA and Dataset Exploration\n",
    "\n",
    "**Project**: BSM Project 3 - D-ResNet Paper Reproduction\n",
    "**Paper**: \"D-Resnet: deep residual neural network for exploration, identification, and classification of beach sand minerals\" (Multimedia Tools and Applications, 2024)\n",
    "**Dataset**: Kaggle `prasannavenkatesant/beach-sand-mineral-bsm`\n",
    "**Step**: 1 of 9 - EDA\n",
    "\n",
    "## Objectives\n",
    "1. Load the dataset from Kaggle\n",
    "2. Print class counts and verify against paper (367 total: 60, 62, 60, 66, 60, 59)\n",
    "3. Show distribution bar chart (paper Fig. 2)\n",
    "4. Show sample image grid (paper Fig. 3)\n",
    "5. Check for corrupt/missing/duplicate images\n",
    "6. Log findings to memory"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "tags": [
     "parameters"
    ]
   },
   "outputs": [],
   "source": [
    "# ========== CONFIGURATION ==========\n",
    "SEED = 42\n",
    "DATASET_SLUG = \"prasannavenkatesant/beach-sand-mineral-bsm\"\n",
    "DATA_DIR = \"/kaggle/input/beach-sand-mineral-bsm\"  # Kaggle default mount path\n",
    "EXPECTED_CLASSES = [\"Ilmenite\", \"Rutile\", \"Zircon\", \"Garnet\", \"Monazite\", \"Sillimanite\"]\n",
    "PAPER_COUNTS = {\"Ilmenite\": 60, \"Rutile\": 62, \"Zircon\": 60, \"Garnet\": 66, \"Monazite\": 60, \"Sillimanite\": 59}\n",
    "PAPER_TOTAL = 367\n",
    "\n",
    "# Output paths\n",
    "RESULTS_DIR = \"/kaggle/working/results\"\n",
    "DATA_INFO_DIR = \"/kaggle/working/data_info\"\n",
    "import os\n",
    "os.makedirs(RESULTS_DIR, exist_ok=True)\n",
    "os.makedirs(DATA_INFO_DIR, exist_ok=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ========== IMPORTS & SEED ==========\n",
    "import os\n",
    "import sys\n",
    "import json\n",
    "import random\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "from collections import Counter\n",
    "import hashlib\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from PIL import Image\n",
    "import cv2\n",
    "\n",
    "# Set seeds for reproducibility\n",
    "random.seed(SEED)\n",
    "np.random.seed(SEED)\n",
    "\n",
    "# Print versions\n",
    "print(f\"Python: {sys.version}\")\n",
    "print(f\"NumPy: {np.__version__}\")\n",
    "print(f\"Pandas: {pd.__version__}\")\n",
    "print(f\"Matplotlib: {plt.matplotlib.__version__}\")\n",
    "print(f\"OpenCV: {cv2.__version__}\")\n",
    "print(f\"PIL: {Image.__version__}\")\n",
    "print(f\"Seed: {SEED}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ========== LOAD DATASET ==========\n",
    "# On Kaggle, dataset is typically mounted at /kaggle/input/<dataset-slug>\n",
    "# Let's explore the structure\n",
    "data_path = Path(DATA_DIR)\n",
    "print(f\"Data path exists: {data_path.exists()}\")\n",
    "print(f\"Data path: {data_path}\")\n",
    "\n",
    "if data_path.exists():\n",
    "    for item in data_path.rglob(\"*\"):\n",
    "        if item.is_file():\n",
    "            print(f\"  {item.relative_to(data_path)} ({item.stat().st_size} bytes)\")\n",
    "else:\n",
    "    print(\"Data path not found. Checking alternative locations...\")\n",
    "    # Try common alternative paths\n",
    "    for alt in [\n",
    "        Path(\"/kaggle/input\") / DATASET_SLUG.replace(\"/\", \"-\"),\n",
    "        Path(\"/kaggle/input/beach-sand-mineral-bsm\"),\n",
    "        Path(\"./data\"),\n",
    "    ]:\n",
    "        if alt.exists():\n",
    "            print(f\"Found at: {alt}\")\n",
    "            data_path = alt\n",
    "            break"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ========== DISCOVER CLASS STRUCTURE ==========\n",
    "# Expect structure: data_dir/class_name/image_files\n",
    "class_dirs = [d for d in data_path.iterdir() if d.is_dir()]\n",
    "print(f\"Found {len(class_dirs)} class directories:\")\n",
    "\n",
    "class_counts = {}\n",
    "all_images = []\n",
    "corrupt_images = []\n",
    "missing_images = []\n",
    "image_hashes = {}\n",
    "duplicates = []\n",
    "\n",
    "for class_dir in sorted(class_dirs):\n",
    "    class_name = class_dir.name\n",
    "    # Get image files (common extensions)\n",
    "    img_files = list(class_dir.glob(\"*.jpg\")) + list(class_dir.glob(\"*.jpeg\")) + \\\n",
    "               list(class_dir.glob(\"*.png\")) + list(class_dir.glob(\"*.bmp\")) + \\\n",
    "               list(class_dir.glob(\"*.tif\")) + list(class_dir.glob(\"*.tiff\"))\n",
    "    \n",
    "    valid_images = []\n",
    "    for img_path in img_files:\n",
    "        try:\n",
    "            # Verify image can be opened\n",
    "            with Image.open(img_path) as img:\n",
    "                img.verify()  # Check for corruption\n",
    "            # Re-open for hashing\n",
    "            with Image.open(img_path) as img:\n",
    "                img_hash = hashlib.md5(img.tobytes()).hexdigest()\n",
    "                if img_hash in image_hashes:\n",
    "                    duplicates.append((img_path, image_hashes[img_hash]))\n",
    "                else:\n",
    "                    image_hashes[img_hash] = img_path\n",
    "            valid_images.append(img_path)\n",
    "            all_images.append((img_path, class_name))\n",
    "        except Exception as e:\n",
    "            corrupt_images.append((img_path, str(e)))\n",
    "    \n    "class_counts[class_name] = len(valid_images)\n",
    "    print(f\"  {class_name}: {len(valid_images)} images\")\n",
    "\n",
    "total_images = sum(class_counts.values())\n",
    "print(f\"\\nTotal valid images: {total_images}\")\n",
    "print(f\"Paper reported total: {PAPER_TOTAL}\")\n",
    "print(f\"Difference: {total_images - PAPER_TOTAL}\")\n",
    "\n",
    "# Check against expected classes\n",
    "for cls in EXPECTED_CLASSES:\n",
    "    if cls not in class_counts:\n",
    "        print(f\"WARNING: Expected class '{cls}' not found!\")\n",
    "    else:\n",
    "        paper_count = PAPER_COUNTS.get(cls, 'N/A')\n",
    "        actual_count = class_counts[cls]\n",
    "        if paper_count != 'N/A' and actual_count != paper_count:\n",
    "            print(f\"  {cls}: paper={paper_count}, actual={actual_count}, diff={actual_count - paper_count}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ========== DISTRIBUTION BAR CHART (Paper Fig. 2) ==========\n",
    "plt.figure(figsize=(10, 6))\n",
    "classes = sorted(class_counts.keys())\n",
    "counts = [class_counts[c] for c in classes]\n",
    "colors = plt.cm.Set2(np.linspace(0, 1, len(classes)))\n",
    "\n",
    "bars = plt.bar(classes, counts, color=colors, edgecolor='black', linewidth=0.7)\n",
    "plt.title('Beach Sand Mineral Dataset - Class Distribution', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Mineral Class', fontsize=12)\n",
    "plt.ylabel('Number of Images', fontsize=12)\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "\n",
    "# Add value labels on bars\n",
    "for bar, count in zip(bars, counts):\n",
    "    plt.text(bar.get_x() + bar.get_width()/2, bar.get_height() + 1,\n",
    "             str(count), ha='center', va='bottom', fontweight='bold')\n",
    "\n",
    "# Add paper counts as reference line\n",
    "paper_counts = [PAPER_COUNTS.get(c, 0) for c in classes]\n",
    "plt.plot(range(len(classes)), paper_counts, 'r--o', label='Paper Reported', markersize=6)\n",
    "plt.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join(RESULTS_DIR, 'class_distribution.png'), dpi=300, bbox_inches='tight')\n",
    "plt.savefig(os.path.join(RESULTS_DIR, 'class_distribution.pdf'), bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# Save counts to CSV\n",
    "counts_df = pd.DataFrame({\n",
    "    'Class': classes,\n",
    "    'Actual_Count': counts,\n",
    "    'Paper_Count': paper_counts,\n",
    "    'Difference': [a - p for a, p in zip(counts, paper_counts)]\n",
    "})\n",
    "counts_df.to_csv(os.path.join(DATA_INFO_DIR, 'class_counts.csv'), index=False)\n",
    "print(\"Class counts saved to data_info/class_counts.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ========== SAMPLE IMAGE GRID (Paper Fig. 3) ==========\n",
    "# Show 3 samples per class (18 total)\n",
    "samples_per_class = 3\n",
    "n_classes = len(classes)\n",
    "\n",
    "fig, axes = plt.subplots(n_classes, samples_per_class, figsize=(12, 2*n_classes))\n",
    "if n_classes == 1:\n",
    "    axes = axes.reshape(1, -1)\n",
    "\n",
    "for i, class_name in enumerate(classes):\n",
    "    class_imgs = [p for p, c in all_images if c == class_name]\n",
    "    selected = class_imgs[:samples_per_class]\n",
    "    \n",
    "    for j, img_path in enumerate(selected):\n",
    "        try:\n",
    "            img = Image.open(img_path).convert('RGB')\n",
    "            axes[i, j].imshow(img)\n",
    "            axes[i, j].axis('off')\n",
    "            if j == 0:\n",
    "                axes[i, j].set_ylabel(class_name, fontsize=12, fontweight='bold', rotation=0, labelpad=40)\n",
    "        except Exception as e:\n",
    "            axes[i, j].text(0.5, 0.5, f'Error: {e}', ha='center', va='center', transform=axes[i, j].transAxes)\n",
    "            axes[i, j].axis('off')\n",
    "\n",
    "plt.suptitle('Sample Images per Class (Paper Fig. 3 style)', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join(RESULTS_DIR, 'sample_grid.png'), dpi=300, bbox_inches='tight')\n",
    "plt.savefig(os.path.join(RESULTS_DIR, 'sample_grid.pdf'), bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ========== IMAGE PROPERTIES ANALYSIS ==========\n",
    "# Check image sizes, channels, etc.\n",
    "sizes = []\n",
    "modes = []\n",
    "aspect_ratios = []\n",
    "\n",
    "for img_path, class_name in all_images[:100]:  # Sample first 100 for speed\n",
    "    try:\n",
    "        with Image.open(img_path) as img:\n",
    "            sizes.append(img.size)  # (width, height)\n",
    "            modes.append(img.mode)\n",
    "            aspect_ratios.append(img.size[0] / img.size[1])\n",
    "    except:\n",
    "        pass\n",
    "\n",
    "if sizes:\n",
    "    widths, heights = zip(*sizes)\n",
    "    print(f\"Image size range: {min(widths)}x{min(heights)} to {max(widths)}x{max(heights)}\")\n",
    "    print(f\"Common sizes: {Counter(sizes).most_common(5)}\")\n",
    "    print(f\"Modes: {Counter(modes)}\")\n",
    "    print(f\"Aspect ratio range: {min(aspect_ratios):.2f} - {max(aspect_ratios):.2f}\")\n",
    "    print(f\"Mean aspect ratio: {np.mean(aspect_ratios):.2f}\")\n",
    "\n",
    "    # Plot size distribution\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "    axes[0].hist(widths, bins=20, alpha=0.7, edgecolor='black', label='Width')\n",
    "    axes[0].hist(heights, bins=20, alpha=0.7, edgecolor='black', label='Height')\n",
    "    axes[0].set_xlabel('Pixels')\n",
    "    axes[0].set_ylabel('Frequency')\n",
    "    axes[0].set_title('Image Dimensions Distribution')\n",
    "    axes[0].legend()\n",
    "    \n",
    "    axes[1].hist(aspect_ratios, bins=20, alpha=0.7, edgecolor='black', color='green')\n",
    "    axes[1].axvline(1.0, color='red', linestyle='--', label='Square (1.0)')\n",
    "    axes[1].set_xlabel('Aspect Ratio (W/H)')\n",
    "    axes[1].set_ylabel('Frequency')\n",
    "    axes[1].set_title('Aspect Ratio Distribution')\n",
    "    axes[1].legend()\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.savefig(os.path.join(RESULTS_DIR, 'image_properties.png'), dpi=300, bbox_inches='tight')\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ========== CORRUPT/MISSING/DUPLICATE REPORT ==========\n",
    "print(f\"Corrupt images: {len(corrupt_images)}\")\n",
    "for path, err in corrupt_images[:10]:\n",
    "    print(f\"  {path.name}: {err}\")\n",
    "if len(corrupt_images) > 10:\n",
    "    print(f\"  ... and {len(corrupt_images) - 10} more\")\n",
    "\n",
    "print(f\"\\nDuplicate images (by pixel content): {len(duplicates)}\")\n",
    "for dup, orig in duplicates[:10]:\n",
    "    print(f\"  {dup.name} duplicates {orig.name}\")\n",
    "if len(duplicates) > 10:\n",
    "    print(f\"  ... and {len(duplicates) - 10} more\")\n",
    "\n",
    "print(f\"\\nMissing images: {len(missing_images)}\")\n",
    "\n",
    "# Save report\n",
    "report = {\n",
    "    \"total_images\": total_images,\n",
    "    \"paper_total\": PAPER_TOTAL,\n",
    "    \"difference\": total_images - PAPER_TOTAL,\n",
    "    \"class_counts\": class_counts,\n",
    "    \"paper_counts\": PAPER_COUNTS,\n",
    "    \"corrupt_count\": len(corrupt_images),\n",
    "    \"corrupt_files\": [str(p) for p, _ in corrupt_images],\n",
    "    \"duplicate_count\": len(duplicates),\n",
    "    \"duplicates\": [[str(d), str(o)] for d, o in duplicates],\n",
    "    \"expected_classes\": EXPECTED_CLASSES,\n",
    "    \"found_classes\": classes\n",
    "}\n",
    "\n",
    "with open(os.path.join(DATA_INFO_DIR, 'eda_report.json'), 'w') as f:\n",
    "    json.dump(report, f, indent=2)\n",
    "\n",
    "print(f\"\\nEDA report saved to {DATA_INFO_DIR}/eda_report.json\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ========== SAVE IMAGE FILE LISTS FOR LATER USE ==========\n",
    "# Save full list of (image_path, class) for augmentation step\n",
    "image_list = []\n",
    "for img_path, class_name in all_images:\n",
    "    image_list.append({\n",
    "        \"path\": str(img_path),\n",
    "        \"class\": class_name,\n",
    "        \"filename\": img_path.name\n",
    "    })\n",
    "\n",
    "with open(os.path.join(DATA_INFO_DIR, 'original_image_list.json'), 'w') as f:\n",
    "    json.dump(image_list, f, indent=2)\n",
    "\n",
    "print(f\"Saved {len(image_list)} original image records to data_info/original_image_list.json\")\n",
    "\n",
    "# Also save as CSV for easy viewing\n",
    "df_images = pd.DataFrame(image_list)\n",
    "df_images.to_csv(os.path.join(DATA_INFO_DIR, 'original_image_list.csv'), index=False)\n",
    "print(f\"Also saved as CSV\")"
   ]
  },
